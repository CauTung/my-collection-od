# Environment Variables — Downies "My Collection"
#
# Copy file này thành .env và điền giá trị thật.
# KHÔNG commit .env vào git.
#
# ⚠️  QUAN TRỌNG — 2 secret KHÁC NHAU, KHÔNG ĐƯỢC DÙNG LẪN:
#   - SHOPIFY_APP_SECRET: chỉ dùng để verify HMAC (App Proxy query params + Webhook raw body)
#   - SHOPIFY_ADMIN_ACCESS_TOKEN: chỉ dùng cho Admin GraphQL API calls
#   Lẫn 2 secret này là lỗi thật đã xảy ra ở lần build trước (xem AGENTS.md Known Pitfalls #1).

# ─── Shopify App Configuration ────────────────────────────────────────────────

# App Secret Key — dùng DUY NHẤT để verify HMAC signature
# Lấy từ: Shopify Partner Dashboard > App > API credentials > Client secret
SHOPIFY_APP_SECRET=
SHOPIFY_CLIENT_ID=

# Admin Access Token — dùng DUY NHẤT cho Admin GraphQL API
# Header: X-Shopify-Access-Token
# Lấy từ: OAuth flow hoặc Shopify Partner Dashboard (dev store custom app)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Shop domain, ví dụ: your-store.myshopify.com
SHOPIFY_SHOP_DOMAIN=

# App host (URL của Remix backend đang chạy)
# Dùng để construct App Proxy URL và webhook callbacks
APP_HOST=

# ─── Third-party Integrations ─────────────────────────────────────────────────

# Yotpo Loyalty — để trống nếu chưa có (mock service sẽ được dùng)
YOTPO_APP_KEY=
YOTPO_SECRET=

# Klaviyo — để trống nếu chưa có (mock service sẽ được dùng)
KLAVIYO_API_KEY=

# ─── Environment ──────────────────────────────────────────────────────────────

# NODE_ENV: development | production | test
NODE_ENV=development
