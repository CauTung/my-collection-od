# Downies My Collection ? local environment template.
# Copy to .env and enter credentials locally. Never commit populated env files.

# Required: secret of the app that owns the App Proxy/webhook subscriptions.
# Used only for HMAC verification, never as an Admin API access token.
SHOPIFY_APP_SECRET=

# Required: actual Admin API access token for the configured shop.
# The current owner setup guide describes the existing legacy custom-app source.
# The application does not acquire or refresh this token automatically.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Required: canonical shop hostname, for example your-store.myshopify.com.
# HTTPS shop-root URLs are normalized; paths, ports and query strings are rejected.
SHOPIFY_SHOP_DOMAIN=

# Operator reference only: not read by application runtime.
# Keep the actual Client ID and stable production URLs aligned in Shopify TOML.
SHOPIFY_CLIENT_ID=
APP_HOST=

# Reserved integration placeholders, currently not read by the mock services.
# Adding values does not enable real Yotpo or Klaviyo delivery.
YOTPO_APP_KEY=
YOTPO_SECRET=
KLAVIYO_API_KEY=

# Runtime logging mode. Hosting providers set this for production builds.
NODE_ENV=development
